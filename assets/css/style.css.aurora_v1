/* ============================================================
   SISTEM LPPM IAKN TORAJA — Ultra Tier Stylesheet
   Font    : Poppins (Google Fonts)
   Design  : Premium Institutional / Enterprise SaaS
   ============================================================ */

/* (Backup version created 2026-04-19 - Aurora v1) */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── CSS VARIABLES ── */
:root {
  /* === BRAND CORE — Aurora Institutional Palette (2026) === */
  --p-h: 245; --p-s: 75%; --p-l: 45%; /* Deep Indigo */
  --primary:        hsl(var(--p-h), var(--p-s), var(--p-l));
  --primary-dark:   hsl(var(--p-h), var(--p-s), 20%);
  --primary-mid:    hsl(var(--p-h), var(--p-s), 55%);
  --primary-light:  hsl(var(--p-h), 40%, 96%);
  --primary-xlight: hsl(var(--p-h), 40%, 98%);
  
  --a-h: 185; --a-s: 90%; --a-l: 45%; /* Aurora Cyan / Tosca */
  --accent:         hsl(var(--a-h), var(--a-s), var(--a-l));
  --accent-dark:    hsl(var(--a-h), var(--a-s), 35%);
  --accent-light:   hsl(var(--a-h), var(--a-s), 85%);
  --accent-glow:    hsla(var(--a-h), var(--a-s), var(--a-l), 0.35);

  /* === NEUTRAL SCALE — Icy Industrial === */
  --text-primary:   #0f172a;
  --text-body:      #334155;
  --text-secondary: #64748b;
  --text-muted:     #94a3b8;
  --text-inverse:   #ffffff;

  --border:         rgba(var(--a-h), 50%, 50%, 0.1);
  --border-light:   #f1f5f9;
  --border-md:      #e2e8f0;
  --bg-page:        #f0f4f8; /* Soft icy background */
  --bg-card:        #ffffff;
  --surface-raised: #ffffff;
  --surface-glass:  rgba(255, 255, 255, 0.7);
  --surface-overlay: rgba(15, 23, 42, 0.45);

  /* === ELEVATION — Tactile Shadows === */
  --shadow-sm:  0 1px 2px rgba(0,0,0,0.05);
  --shadow-md:  0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
  --shadow-lg:  0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
  --shadow-xl:  0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
  --shadow-premium: 0 0 0 1px rgba(0,0,0,0.05), 0 10px 30px -10px rgba(74, 29, 150, 0.2);

  /* === TYPOGRAPHY — Fluid System === */
  --font-base: 'Poppins', system-ui, -apple-system, sans-serif;
  --fs-xs: clamp(0.7rem, 0.65rem + 0.2vw, 0.75rem);
  --fs-sm: clamp(0.8rem, 0.75rem + 0.2vw, 0.875rem);
  --fs-base: clamp(0.9rem, 0.85rem + 0.2vw, 1rem);
  --fs-md: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
  --fs-lg: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
  --fs-xl: clamp(1.5rem, 1.35rem + 0.6vw, 2rem);

  /* === GEOMETRY — Smooth Corners === */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --radius-xl: 32px;
  --radius-full: 9999px;

  /* === MOTION === */
  --transition: 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --spring: 400ms cubic-bezier(0.34, 1.56, 0.64, 1);

  /* === LAYOUT === */
  --sidebar-w: 260px;
  --topbar-h: 70px;
}

