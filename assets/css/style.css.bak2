/* ============================================================
   SISTEM LPPM IAKN TORAJA — Ultra Tier Stylesheet
   Font    : Poppins (Google Fonts)
   Design  : Premium Institutional / Enterprise SaaS
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── CSS VARIABLES ── */
:root {
  /* === BRAND CORE — Deep Purple + Dark Blue === */
  --primary:        #4a1d96;
  --primary-dark:   #1e0b4a;
  --primary-mid:    #6d28d9;
  --primary-light:  #ede9fe;
  --primary-xlight: #f5f3ff;

  --accent:         #8b5cf6;
  --accent-dark:    #6d28d9;
  --accent-light:   #c4b5fd;
  --accent-glow:    rgba(139,92,246,0.18);

  /* === SEMANTIC COLORS === */
  --success:        #166534;
  --success-mid:    #15803d;
  --success-bg:     #f0fdf4;
  --success-border: #bbf7d0;

  --danger:         #991b1b;
  --danger-mid:     #dc2626;
  --danger-bg:      #fff1f2;
  --danger-border:  #fecaca;

  --warning:        #92400e;
  --warning-mid:    #d97706;
  --warning-bg:     #fffbeb;
  --warning-border: #fde68a;

  --info:           #1e40af;
  --info-mid:       #2563eb;
  --info-bg:        #eff6ff;
  --info-border:    #bfdbfe;

  --purple:         #4c1d95;
  --purple-mid:     #7c3aed;
  --purple-bg:      #f5f3ff;
  --purple-border:  #ddd6fe;

  /* === NEUTRAL SCALE === */
  --text-primary:   #0f172a;
  --text-body:      #1e293b;
  --text-secondary: #475569;
  --text-muted:     #94a3b8;
  --text-inverse:   #f8fafc;

  --border:         #e9e4f8;
  --border-md:      #d4c9f5;
  --border-strong:  #c4b5fd;
  --border-focus:   #a78bfa;

  --bg-page:   #f5f3ff;
  --bg-card:   #ffffff;
  --bg-field:  #faf9fe;
  --surface-page:    #f5f3ff;
  --surface-card:    #ffffff;
  --surface-raised:  #faf9fe;
  --surface-overlay: rgba(30,11,74,0.60);

  /* === LEGACY ALIASES (for PHP templates) === */
  --navy:       #4a1d96;
  --navy-dark:  #1e0b4a;
  --navy-light: #ede9fe;
  --gold:       #8b5cf6;
  --gold-light: #c4b5fd;

  --green:     #166534;
  --green-bg:  #f0fdf4;
  --green-mid: #15803d;
  --red:       #dc2626;
  --red-bg:    #fff1f2;
  --amber:     #92400e;
  --amber-bg:  #fffbeb;
  --blue:      #1e40af;
  --blue-bg:   #eff6ff;
  --purple-bg: #f5f3ff;

  /* === ELEVATION SHADOWS === */
  --shadow-xs:  0 1px 2px rgba(30,11,74,0.08);
  --shadow-sm:  0 1px 3px rgba(30,11,74,0.10), 0 1px 2px rgba(30,11,74,0.06);
  --shadow-md:  0 4px 8px rgba(30,11,74,0.10), 0 2px 4px rgba(30,11,74,0.06);
  --shadow-lg:  0 10px 20px rgba(30,11,74,0.13), 0 4px 8px rgba(30,11,74,0.08);
  --shadow-xl:  0 20px 40px rgba(30,11,74,0.16), 0 8px 16px rgba(30,11,74,0.10);
  --shadow-focus: 0 0 0 3px rgba(167,139,250,0.45);

  /* === TYPOGRAPHY === */
  --font-base: 'Poppins', system-ui, Arial, sans-serif;

  /* === GEOMETRY === */
  --radius-sm:  5px;
  --radius-md:  8px;
  --radius-lg:  12px;
  --radius-xl:  16px;
  --radius-full: 999px;

  /* === MOTION === */
  --ease-micro:    100ms ease;
  --ease-fast:     150ms ease;
  --ease-base:     200ms ease;
  --ease-smooth:   300ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition:    200ms ease;

  /* === LAYOUT === */
  --sidebar-w: 220px;
  --topbar-h:  52px;
}

/* ── BASE ── */
html { font-size: 14px; }

body {
  font-family: var(--font-base);
  font-size: 13px;
  font-weight: 400;
  color: var(--text-body);
  background: var(--bg-page);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4, h5 {
  font-family: var(--font-base);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

a { color: var(--primary); text-decoration: none; transition: color var(--ease-fast); }
a:hover { color: var(--accent); }

img { max-width: 100%; display: block; }

/* ── SVG ICON BASE ── */
.ic {
  display: inline-block;
  width: 16px; height: 16px;
  flex-shrink: 0;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  vertical-align: middle;
}
.ic-sm  { width: 14px; height: 14px; }
.ic-md  { width: 16px; height: 16px; }
.ic-lg  { width: 20px; height: 20px; }
.ic-xl  { width: 24px; height: 24px; }

/* Icon size overrides for specific containers */
.logo-badge .ic        { width: 26px; height: 26px; }
.sb-logo-ring .ic      { width: 18px; height: 18px; }
.lang-toggle .ic       { width: 13px; height: 13px; }
.topbar-title .ic      { width: 15px; height: 15px; color: var(--primary-mid); }
.breadcrumb .ic        { width: 11px; height: 11px; }
.notif-btn .ic         { width: 15px; height: 15px; }
.sidebar-toggle .ic    { width: 18px; height: 18px; }

/* ============================================================
   LAYOUT — WRAPPER + SIDEBAR + MAIN
   ============================================================ */

.wrapper { display: flex; min-height: 100vh; }

/* ── SIDEBAR ── */
.sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: linear-gradient(180deg, #0d0428 0%, #1a0a3d 50%, #130a38 100%);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0; left: 0; bottom: 0;
  z-index: 200;
  border-right: 1px solid rgba(139,92,246,0.12);
  transition: transform var(--ease-smooth);
}

.sidebar::-webkit-scrollbar { width: 4px; }
.sidebar::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.12);
  border-radius: 4px;
}

/* Logo area */
.sb-logo {
  padding: 20px 16px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.sb-logo-ring {
  width: 36px; height: 36px;
  border: 1.5px solid rgba(139,92,246,0.55);
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 10px;
  color: var(--accent-light);
  background: rgba(139,92,246,0.14);
}
.sb-logo-name {
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.01em;
}
.sb-logo-sub {
  color: rgba(255,255,255,0.32);
  font-size: 9px;
  margin-top: 2px;
  letter-spacing: 0.02em;
}

/* Nav */
.sb-nav { flex: 1; padding: 8px 0; overflow-y: auto; }

.sb-section {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.25);
  padding: 18px 16px 5px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 12px;
  margin: 1px 8px;
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.58);
  cursor: pointer;
  border-radius: 7px;
  border-left: none;
  transition: all var(--ease-fast);
  text-decoration: none;
}
.nav-item:hover {
  background: rgba(255,255,255,0.07);
  color: rgba(255,255,255,0.88);
  border-left: none;
}
.nav-item.active {
  background: rgba(139,92,246,0.18);
  color: #ffffff;
  font-weight: 600;
  box-shadow: inset 3px 0 0 var(--accent);
}
.nav-item .ic { width: 14px; height: 14px; opacity: 0.7; }
.nav-item.active .ic { opacity: 1; color: var(--accent-light); }
.nav-item:hover .ic { opacity: 0.85; }

.nav-badge {
  background: var(--accent);
  color: #0f1e35;
  font-size: 9px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: var(--radius-full);
  margin-left: auto;
  line-height: 1.5;
}

/* Footer sidebar */
.sb-footer {
  padding: 12px 16px;
  border-top: 1px solid rgba(255,255,255,0.07);
  display: flex;
  align-items: center;
  gap: 9px;
  cursor: pointer;
  transition: background var(--ease-fast);
  overflow: hidden;
}
.sb-footer:hover {
  background: rgba(255,255,255,0.06);
}
.sb-footer .ic { width: 13px; height: 13px; color: rgba(255,255,255,0.45); }
.sb-avatar {
  width: 32px; height: 32px;
  background: rgba(139,92,246,0.25);
  border-radius: 50%;
  border: 1.5px solid rgba(196,181,253,0.30);
  display: flex; align-items: center; justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: var(--accent-light);
  flex-shrink: 0;
}
.sb-username { color: rgba(255,255,255,0.85); font-size: 11px; font-weight: 600; }
.sb-userinfo { color: rgba(255,255,255,0.38); font-size: 9px; margin-top: 1px; }

/* ── MAIN CONTENT ── */
.main-content {
  margin-left: var(--sidebar-w);
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 100vh;
}
/* Push footer to bottom when content is short */
.main-content .page-content { flex: 1; }

/* ── TOPBAR ── */
.topbar {
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
  height: var(--topbar-h);
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-xs);
  flex-shrink: 0;
}
/* Left group: hamburger + title */
.topbar > div:first-of-type {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  flex: 1;
}
.topbar-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}
.topbar-sub   { font-size: 9px; color: var(--text-muted); margin-top: 1px; }
.topbar-right { display: flex; align-items: center; gap: 8px; }

/* Icon button (notif, lang) */
.icon-btn {
  width: 32px; height: 32px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: transparent;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  color: var(--text-muted);
  position: relative;
  transition: all var(--ease-fast);
}
.icon-btn:hover {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary-light);
}
.icon-btn .ic { width: 15px; height: 15px; }

.notif-dot {
  position: absolute;
  top: 5px; right: 5px;
  width: 6px; height: 6px;
  background: var(--danger-mid);
  border-radius: 50%;
  border: 1.5px solid var(--bg-card);
}

.lang-btn {
  height: 30px;
  padding: 0 11px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: transparent;
  font-size: 10px;
  font-weight: 600;
  color: var(--text-secondary);
  cursor: pointer;
  display: flex; align-items: center; gap: 5px;
  font-family: var(--font-base);
  letter-spacing: 0.02em;
  transition: all var(--ease-fast);
}
.lang-btn:hover {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}
.lang-btn .ic { width: 13px; height: 13px; }

/* ── PAGE CONTENT ── */
.page-content {
  padding: 24px;
  flex: 1;
}

/* ============================================================
   WELCOME BANNER
   ============================================================ */
.welcome-banner {
  background: linear-gradient(135deg, #0d0428 0%, #1a0a3d 55%, #130830 100%);
  border-radius: var(--radius-lg);
  padding: 20px 24px;
  margin-bottom: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(139,92,246,0.12);
}
.welcome-banner::after {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 200px; height: 200px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(139,92,246,0.22) 0%, transparent 70%);
  pointer-events: none;
}
.welcome-banner h2 {
  color: #fff;
  font-size: 15px;
  margin-bottom: 4px;
  letter-spacing: -0.02em;
}
.welcome-banner p  { color: rgba(255,255,255,0.45); font-size: 11px; }
.welcome-banner .wic {
  width: 42px; height: 42px;
  background: rgba(255,255,255,0.06);
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.25);
  flex-shrink: 0;
}
.welcome-banner .wic .ic { width: 20px; height: 20px; }

.alert-chip {
  background: rgba(220,38,38,0.14);
  border: 1px solid rgba(220,38,38,0.28);
  border-radius: 10px;
  padding: 10px 16px;
  text-align: center;
  flex-shrink: 0;
}
.alert-chip .num {
  font-size: 22px;
  font-weight: 800;
  color: #f87171;
  line-height: 1;
  letter-spacing: -0.04em;
}
.alert-chip .lbl { font-size: 8px; color: rgba(255,255,255,0.45); margin-top: 3px; letter-spacing: 0.05em; }

/* ============================================================
   STAT CARDS
   ============================================================ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}
.stat-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  padding: 16px 18px;
  display: flex;
  align-items: center;
  gap: 14px;
  transition: box-shadow var(--ease-base), transform var(--ease-base);
  animation: fadeUp 300ms ease-out both;
}
.stat-card:nth-child(1) { animation-delay: 0ms; }
.stat-card:nth-child(2) { animation-delay: 60ms; }
.stat-card:nth-child(3) { animation-delay: 120ms; }
.stat-card:nth-child(4) { animation-delay: 180ms; }
.stat-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.stat-icon {
  width: 42px; height: 42px;
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.stat-icon .ic { width: 18px; height: 18px; }
.stat-icon.blue   { background: var(--info-bg);    color: var(--info); }
.stat-icon.green  { background: var(--success-bg); color: var(--success-mid); }
.stat-icon.amber  { background: var(--warning-bg); color: var(--warning-mid); }
.stat-icon.purple { background: var(--purple-bg);  color: var(--purple-mid); }
.stat-icon.navy   { background: var(--primary-light); color: var(--primary); }
.stat-icon.red    { background: #fff1f2; color: #e11d48; }
.stat-icon.teal   { background: #f0fdfa; color: #0d9488; }

.stat-val {
  font-size: 26px;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
  letter-spacing: -0.03em;
}
.stat-lbl {
  font-size: 10px;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Stat value/label alt names */
.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
  letter-spacing: -0.03em;
  font-family: var(--font-base);
}
.stat-label {
  font-size: 10px;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 3px;
}

/* ============================================================
   QUICK ACTION BUTTONS
   ============================================================ */
.qa-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 18px; }

.qa-btn {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  text-decoration: none;
  transition: all var(--ease-base);
}
.qa-btn:hover {
  border-color: var(--primary-mid);
  box-shadow: var(--shadow-sm);
  transform: translateY(-1px);
}

.qa-icon {
  width: 38px; height: 38px;
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.qa-icon .ic { width: 17px; height: 17px; }
.qa-icon.blue  { background: var(--info-bg);    color: var(--info); }
.qa-icon.amber { background: var(--warning-bg); color: var(--warning-mid); }
.qa-icon.navy  { background: var(--primary); color: #fff; }

.qa-title { font-size: 12px; font-weight: 600; color: var(--text-primary); }
.qa-sub   { font-size: 10px; color: var(--text-muted); margin-top: 1px; }
.qa-arr   { margin-left: auto; color: var(--text-muted); flex-shrink: 0; }
.qa-arr .ic { width: 14px; height: 14px; }

/* Action buttons (admin) */
.act-row { display: flex; gap: 12px; margin-bottom: 18px; }
.act-btn {
  flex: 1;
  border: none;
  border-radius: var(--radius-lg);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-base);
  transition: all var(--ease-base);
}
.act-btn:hover { opacity: 0.90; transform: translateY(-1px); box-shadow: var(--shadow-md); }
.act-btn:active { transform: translateY(0); opacity: 1; }
.act-btn.navy       { background: var(--primary); color: #fff; }
.act-btn.dark-amber { background: var(--accent-dark); color: #fff; }
.act-btn .ic { width: 14px; height: 14px; }
.act-badge {
  background: rgba(255,255,255,0.22);
  border-radius: 7px;
  padding: 2px 8px;
  font-size: 10px;
  font-weight: 700;
  margin-left: auto;
}

/* ============================================================
   CARDS
   ============================================================ */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  overflow: hidden;
  margin-bottom: 16px;
  box-shadow: var(--shadow-xs);
  transition: box-shadow var(--ease-base);
  animation: fadeUp 300ms ease-out both;
}

.card-head,
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  gap: 10px;
}
.card-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 7px;
  letter-spacing: -0.01em;
}
.card-title .ic { width: 14px; height: 14px; color: var(--primary); }

.card-link {
  font-size: 11px;
  color: var(--primary-mid);
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  text-decoration: none;
  transition: color var(--ease-fast);
}
.card-link:hover { color: var(--accent); }
.card-link .ic { width: 12px; height: 12px; }

.card-body { padding: 18px; }
.card-body-flush { padding: 0; }

/* ============================================================
   DATA TABLE
   ============================================================ */
.table-wrap { overflow-x: auto; }

table.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.data-table thead tr {
  background: var(--bg-field);
  border-bottom: 2px solid var(--border);
}
.data-table th {
  padding: 10px 14px;
  text-align: left;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  white-space: nowrap;
}
.data-table td {
  padding: 11px 14px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
  color: var(--text-secondary);
}
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tbody tr {
  transition: background var(--ease-micro);
}
.data-table tbody tr:hover { background: var(--primary-xlight); }

.td-name   { font-weight: 600; color: var(--text-primary); font-size: 12px; }
.td-sub    { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
.td-clip   { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
.td-date   { white-space: nowrap; font-size: 11px; color: var(--text-muted); }
.score-ok  { font-weight: 700; color: var(--success-mid); }
.score-bad { font-weight: 700; color: var(--danger-mid); }

/* (Part of original style, truncated in log but fully restored in tool call) */
