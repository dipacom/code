/* ============================================================
   ADMIN GUIDE / PANDUAN WORKFLOW (.guide-panel)
   ============================================================ */

.guide-panel {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24px;
  box-shadow: var(--shadow-sm);
}

.guide-header {
  padding: 16px 20px;
  background: var(--bg-field);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: background 0.2s;
}

.guide-header:hover { background: var(--primary-xlight); }

.guide-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.guide-header-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: var(--primary);
  color: #fff;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
}

.guide-header-steps-count {
  font-size: 11px;
  color: var(--text-muted);
}

.guide-toggle-btn {
  background: none;
  border: none;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-secondary);
  cursor: pointer;
}

.guide-toggle-btn svg { transition: transform 0.3s; }
.guide-toggle-btn.open svg { transform: rotate(180deg); }

.guide-body {
  display: none;
  padding: 24px;
}

.guide-body.open { display: block; }

/* Flow Layout */
.guide-flow {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.guide-flow-row {
  display: flex;
  align-items: stretch;
  gap: 12px;
  flex-wrap: wrap;
}

.guide-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--border-strong);
  padding: 0 4px;
}

/* Step Card */
.guide-step-card {
  flex: 1;
  min-width: 200px;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.guide-step-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.gsc-top {
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
}

.gsc-num {
  width: 24px;
  height: 24px;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
}

.gsc-ico {
  display: flex;
  align-items: center;
}

.gsc-pill {
  margin-left: auto;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  background: rgba(255,255,255,0.2);
  padding: 2px 8px;
  border-radius: 4px;
}

.gsc-body {
  padding: 14px 16px;
}

.guide-step-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6px;
  line-height: 1.4;
}

.guide-step-desc-text {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.6;
}

@media (max-width: 768px) {
  .guide-flow-row { flex-direction: column; }
  .guide-arrow { transform: rotate(90deg); padding: 10px 0; }
}

/* ============================================================
   RESPONSIVE TABLE (.resp-table)
   ============================================================ */

.resp-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.resp-table thead tr {
  background: var(--bg-field);
  border-bottom: 2px solid var(--border);
}

.resp-table th {
  padding: 12px 16px;
  text-align: left;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}

.resp-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  color: var(--text-secondary);
}

@media (max-width: 768px) {
  .resp-table, .resp-table thead, .resp-table tbody, .resp-table th, .resp-table td, .resp-table tr {
    display: block;
  }
  
  .resp-table thead tr {
    position: absolute;
    top: -9999px;
    left: -9999px;
  }
  
  .resp-table tr {
    border: 1px solid var(--border);
    margin-bottom: 10px;
    background: #fff;
    border-radius: 8px;
    padding: 8px;
  }
  
  .resp-table td {
    border: none;
    border-bottom: 1px solid var(--primary-light);
    position: relative;
    padding-left: 45%;
    text-align: left;
  }
  
  .resp-table td:last-child {
    border-bottom: none;
  }
  
  .resp-table td:before {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 40%;
    padding-right: 10px;
    white-space: nowrap;
    content: attr(data-label);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--primary);
  }
}

/* ============================================================
   SITE FOOTER (Copyright Section)
   ============================================================ */

.site-footer {
  padding: 24px;
  margin-top: auto;
  text-align: center;
  font-size: 11px;
  color: var(--text-muted);
  border-top: 1px solid var(--border);
  background: transparent;
  width: 100%;
}

.site-footer strong {
  color: var(--primary-mid);
  font-weight: 600;
}
